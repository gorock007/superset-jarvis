diff --git a/cli/_dates.py b/cli/_dates.py
new file mode 100644
--- /dev/null
+++ b/cli/_dates.py
@@ -0,0 +1,10 @@
+import datetime
+
+import click
+
+
+def parse_day(value):
+    try:
+        return datetime.date.fromisoformat(value)
+    except ValueError:
+        raise click.BadParameter("Invalid --since date, expected YYYY-MM-DD")
